# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default is 3000)
PORT=3000

# Optional Database URL (for persistent simulation archiving)
DATABASE_URL=

# -----------------------------------------------------------------------------
# OORCA Environmental Data Provider Keys (Optional: Open-Meteo works without keys)
# -----------------------------------------------------------------------------
WEATHER_API_KEY=
OCEAN_DATA_API_KEY=
NOAA_API_KEY=
COPERNICUS_API_KEY=

# Satellite Data API (e.g., Copernicus Open Access Hub / Sentinel Hub)
VITE_SATELLITE_API_KEY=

# AIS Vessel Tracking API (e.g., Spire Global Maritime / MarineTraffic)
VITE_AIS_API_KEY=

# CARTO Map / Basemap API Key
VITE_CARTO_API_KEY=
